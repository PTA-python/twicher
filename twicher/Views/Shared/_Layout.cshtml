<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - twicher</title>
    <script type="importmap"></script>
    <link href="~/images/favicon.png" rel="icon" type="image/svg" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/twicher.styles.css" asp-append-version="true" />
</head>
<body>

    <div id=" wrapper">

        @* top bar *@
        <header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center bg-white/80 sky-50 backdrop-blur-xl border-b border-slate-200">
            <div class="2xl:w-[--w-side] lg:w-[--w-side-sm]">
                <div class="flex items-center gap-1">
                    <button uk-toggle="targe: #site__sidebar ; cls :!-translate-x-0"
                            class="flex items-center justify-center w-8 h-8 text-xl rounded-full hover:bg-gray-100 xl:hidden-group">
                        <ion-icon name="menu-outline" class="text-2xl group-aria-expanded:hidden"></ion-icon>
                        <ion-icon name="close-outline" class="hidden text-2xl group-aria-expanded:block"></ion-icon>
                    </button>


                    <div id="logo" class="flex items-center">
                        <a class="flex items-center">
                            <img src="~/images/logo.png" class="w-10 md:block hidden" />
                            <span class="ml-2">Twicher</span>
                        </a>

                    </div>

                </div>

            </div>
            <div class="flex-1 relative">
                <div class="max-w-[1220px] mx-auto flex items-center">
                    <form id="search--box" class="xl:w-[680px] sm:w-96 sm:relative rounded-xl overflow-hidden z-20 bg-gray-100 max-md:hidden w-screen left-0 max-sm:fixed max-sm:top-2" style="background-color:#d5dae0;">
                        <ion-icon name="search" class="absolute top-1/2 -translate-y-1/2 left-3 text-xl text-gray-900"></ion-icon>
                        <input type="text" name="query" value="" placeholder="Search..." class="w-full !pl-10 !font-normal !bg-transparent h-12 !text-sm text-black" style="color:#111827 !important; caret-color:#111827 !important;" />
                    </form>

                </div>
                <div class="max-w-[1220px] mx-auto flex items-center">
                    <div class="flex items-center gap-sm-4 gap-2 absolute right-5 top-1/2 -translate-y-1/2 text-black">
                        @* notification icon *@
                        <button type="button" class="sm:p-2 p-1 rounded-full relative sm:bg-gray-100">
                            <svg fill="#000000" width="24px" height="24px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M14.8292095,19 C14.4116155,20.1832024 13.2866108,21 12,21 C10.7105968,21 9.58711809,20.1801692 9.17072899,19 L7.57752396,19 C6.19681208,19 5.07752396,17.8807119 5.07752396,16.5 C5.07752396,16.1502041 5.15092953,15.8043013 5.29299508,15.4846538 L6,13.8938928 L6,11 C6,8.38756235 7.66961525,6.16508423 10,5.34141142 L10,5 C10,3.8954305 10.8954305,3 12,3 C13.1045695,3 14,3.8954305 14,5 L14,5.34141142 C16.3303847,6.16508423 18,8.38756235 18,11 L18,13.8938928 L18.7070049,15.4846538 C19.2677651,16.7463643 18.6995327,18.2237687 17.4378222,18.7845289 C17.1181747,18.9265944 16.7722719,19 16.422476,19 L14.8292095,19 L14.8292095,19 Z M13.7328929,19 L10.267086,19 C10.6157944,19.6033146 11.26791,20 12,20 C12.730784,20 13.3835919,19.6045386 13.7328929,19 L13.7328929,19 Z M13,5.08295844 L13,5 C13,4.44771525 12.5522847,4 12,4 C11.4477153,4 11,4.44771525 11,5 L11,5.08295844 C11.3252085,5.0283988 11.6592878,5 12,5 C12.3407122,5 12.6747915,5.0283988 13,5.08295844 L13,5.08295844 Z M12,6 C9.23857625,6 7,8.23857625 7,11 L7,14 L6.95690577,14.2030692 L6.20680663,15.8907923 C6.1215673,16.0825808 6.07752396,16.2901225 6.07752396,16.5 C6.07752396,17.3284271 6.74909683,18 7.57752396,18 L16.422476,18 C16.6323536,18 16.8398952,17.9559567 17.0316837,17.8707173 C17.78871,17.5342612 18.1296495,16.6478186 17.7931934,15.8907923 L17.0430942,14.2030692 L17,14 L17,11 C17,8.23857625 14.7614237,6 12,6 Z" />
                            </svg>
                            <div class="absolute top-0 right-0 -m-1 bg-red-600 text-white text-xs px-1 rounded-full" id="notificationcount"> 0 </div>
                        </button>

                        <div class="hidden bg-white pr-1.5 rounded-lg drop-shadow-xl md:w-[365px] w-screen border-2" uk-drop="offset: 6; pos: bottom-right; mode: click; animate-out: true;">
                            <div class="flex items-center justify-between gap-2 p-4 pb-2">
                                <h3 class="font-semibold text-xl text-black m-0" style="color:#111827 !important;">Notifications</h3>
                            </div>

                            <div class="text-sm h-[400px] w-full overflow-y-auto pr-2">
                                <div class="pl-2 p-1 text-sm font-normal text-black" id="notification-dropdown" style="color:#111827 !important;">No notifications....</div>
                            </div>
                        </div>
                        <div class="rounded-full relative bg-gray-100 cursor-pointer shrink-0">
                            <img src="~/images/avatar/user.png" class="sm:w-9 sm:h-9 w-7 h-7 rounded-full shadow shrink-0" />
                        </div>
                        <div class="hidden bg-white rounded-lg drop-shadow-xl w-64 border2" uk-drop="offset: 6; pos: bottom-right; animate-out: true;">
                            <a>
                                <div class="p-4 py-5 flex items-center gap-4">
                                    <img src="~/images/avatar/user.png" class="w-10 h-10 rounded-full shadow" />
                                    <div class="flex-1">
                                        <h4 class="text-sm font-medium text-black m-0" style="color:#111827 !important;">Pham Tuan Anh</h4>
                                        <div class="text-sm mt-1 text-blue-600 font-light/70">PTA</div>
                                    </div>
                                </div>
                            </a>
                            <hr />
                            <nav>
                                <a>
                                    <div class="flex items-center gap-2.5 p-2 px-2.5 rounded-md hover:bg-gray-100 text-black">
                                        <ion-icon name="settings-outline" class="text-lg "></ion-icon> My Account
                                    </div>
                                </a>
                                <hr />
                                <a>
                                    <div class="flex items-center gap-2.5 p-2 px-2.5 rounded-md hover:bg-gray-100 text-black">
                                        <ion-icon name="exit-outline" class="text-lg "></ion-icon> Log Out
                                    </div>
                                </a>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        @* side bar (left) *@


        @RenderBody()
    </div>

           


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Asset scripts *@
    <script src="~/js/simplebar.js"></script>
    <script src="~/js/uikit.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
